{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知域",
  "version": "0.1.23",
  "identifier": "com.zhishu.pkas",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "本地个人知识系统",
    "longDescription": "帮助个人整理本机资料、建立可追溯的全文与向量检索，并连接兼容的 AI 客户端。",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../runtime/tauri-source/": "pkas-app/src/pkas/",
      "../../pyproject.toml": "pkas-app/pyproject.toml",
      "../../uv.lock": "pkas-app/uv.lock",
      "../../README.md": "pkas-app/README.md",
      "../../web/dist/": "pkas-app/web/dist/",
      "../../runtime/tauri-payload/": "pkas-app/runtime/",
      "../../tools/everything/": "pkas-app/tools/everything/",
      "icons/icon.ico": "pkas-app/app-icon.ico",
      "../../scripts/configure_rpa_loopback.ps1": "pkas-app/scripts/configure_rpa_loopback.ps1",
      "../../scripts/configure_weflow_manual.mjs": "pkas-app/scripts/configure_weflow_manual.mjs",
      "../../scripts/configure_scheduled_sync.ps1": "pkas-app/scripts/configure_scheduled_sync.ps1",
      "../../scripts/resolve_sync_runtime.ps1": "pkas-app/scripts/resolve_sync_runtime.ps1",
      "../../scripts/install_scheduled_sync.ps1": "pkas-app/scripts/install_scheduled_sync.ps1",
      "../../scripts/run_scheduled_sync.ps1": "pkas-app/scripts/run_scheduled_sync.ps1",
      "../../scripts/uninstall_scheduled_sync.ps1": "pkas-app/scripts/uninstall_scheduled_sync.ps1",
      "../../scripts/arm_sync_catchup.ps1": "pkas-app/scripts/arm_sync_catchup.ps1",
      "../../scripts/write_sync_diagnostic.ps1": "pkas-app/scripts/write_sync_diagnostic.ps1",
      "../../scripts/assert_windows_autostart_allowed.ps1": "pkas-app/scripts/assert_windows_autostart_allowed.ps1",
      "../../scripts/configure_weflow_daily.mjs": "pkas-app/scripts/configure_weflow_daily.mjs",
      "../../scripts/weflow_schedule.mjs": "pkas-app/scripts/weflow_schedule.mjs",
      "../../scripts/weflow_export_status.ps1": "pkas-app/scripts/weflow_export_status.ps1"
    },
    "useLocalToolsDir": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
